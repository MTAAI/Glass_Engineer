notepad .env.example
```

**Step 2 — Paste this content into Notepad:**
```
# Glass Expert AI — Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://glassai:glassai_secret@localhost:5432/glass_expert_ai

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-minimum-32-chars
JWT_EXPIRE_MINUTES=480

# ── Embedding ──────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_USE_FP16=true
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_LENGTH=512

# ── Reranker ───────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
RERANK_ENABLED=true
RERANK_TOP_N=5

# ── Retrieval ──────────────────────────────────────────────
RETRIEVAL_TOP_K=30
RETRIEVAL_FINAL_TOP_K=8
SIMILARITY_THRESHOLD=0.30

# ── LLM (local vLLM server) ────────────────────────────────
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=glass-expert
LLM_API_KEY=token-glass-ai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── Fallback LLM ───────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── API Server ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080