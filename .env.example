# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Processing Configuration
MAX_WORKERS=4
CHUNK_SIZE=1500
QA_PER_CHUNK=2

# Database Configuration
DATABASE_URL=postgresql://glassai:glassai_secret@localhost:5432/glass_expert_ai

# Redis Cache
REDIS_URL=redis://localhost:6379

# Local LLM (vLLM on port 8000)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=glass-expert
LLM_API_KEY=token-glass-ai
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3

# API Server
API_HOST=0.0.0.0
API_PORT=8080

# Auth / JWT
JWT_SECRET_KEY=change-this-to-a-random-secret
JWT_EXPIRE_MINUTES=480




