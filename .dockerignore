# ============================================================
# Glass Expert AI — Docker Build Exclusions
# ============================================================

# Virtual environments
.venv/
venv/
venv_train/

# Git
.git/
.gitignore
.gitattributes

# Models (large — served by vLLM separately, mounted at runtime)
models/
*.safetensors
*.bin
*.pt
*.gguf

# Data files
data/
logs/
*.npz
*.jsonl

# Node modules (rebuilt inside Docker)
frontend/node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Docker (avoid recursive copy)
docker-compose.yml
.dockerignore

# Claude / dev config
.claude/

# Env files (injected at runtime via docker-compose)
.env
.env.*

# Training artifacts
scripts/training/
unsloth_compiled_cache/

# Misc
cloudflared.exe
*.md
*.log
tests/
